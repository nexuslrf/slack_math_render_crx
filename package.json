{
  "name": "slack-math-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Local LaTeX rendering for Slack Web, packaged as a Chrome extension.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/parser.test.mjs && playwright test",
    "test:unit": "node --test tests/parser.test.mjs",
    "test:browser": "playwright test",
    "package": "npm run build && python3 scripts/package.py"
  },
  "dependencies": {
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
